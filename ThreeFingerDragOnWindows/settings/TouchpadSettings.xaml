<Page
    x:Class="ThreeFingerDragOnWindows.settings.TouchpadSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:ThreeFingerDragOnWindows.localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollView HorizontalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,0,32,32"
                    MaxWidth="920"
                    HorizontalAlignment="Stretch"
                    ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
                    Spacing="16">

            <Border x:Name="Loader"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ProgressRing Width="20" Height="20" IsActive="True" />
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Key=S006}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{loc:Translate Key=S007}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="TouchpadStatus"
                    Visibility="Collapsed"
                    Padding="24"
                    Background="{StaticResource SuccessTintBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid ColumnSpacing="18" SizeChanged="ActionRow_SizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" FontSize="22" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="StatusTitleText" Text="{loc:Translate Key=S008}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusDescriptionText"
                                   Text="{loc:Translate Key=S009}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{loc:Translate Key=S010}"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OpenDragSettings" />
                </Grid>
            </Border>

            <TextBlock Text="{loc:Translate Key=S011}" Margin="0,8,0,0"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <Border Padding="20,6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <Grid MinHeight="68" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="ConnectionStepIcon" Glyph="&#xE73E;" FontSize="18"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Key=S012}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ConnectionStepDescription" Text="{loc:Translate Key=S013}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Margin="52,0,0,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid MinHeight="78" ColumnSpacing="16" SizeChanged="ActionRow_SizeChanged">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7C9;" FontSize="18" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Key=S014}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{loc:Translate Key=S015}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{loc:Translate Key=S016}" Click="OpenWindowsTouchpadSettings" />
                    </Grid>
                    <Rectangle Height="1" Margin="52,0,0,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid MinHeight="78" ColumnSpacing="16" SizeChanged="ActionRow_SizeChanged">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE759;" FontSize="18" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Key=S017}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{loc:Translate Key=S018}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{loc:Translate Key=S019}" Click="OpenDragSettings" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Translate Key=S020}" Margin="0,8,0,0"
                       Style="{ThemeResource TitleTextBlockStyle}" />
            <Border x:Name="ContactsDebug"
                    Visibility="Collapsed"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="LiveIndicator" Width="10" Height="10"
                                 Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                 VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="LiveInputTitle" Text="{loc:Translate Key=S021}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="LiveInputSubtitle"
                                       Text="{loc:Translate Key=S022}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Expander Header="{loc:Translate Key=S023}" IsExpanded="False">
                        <TextBlock x:Name="RawInputText"
                                   Margin="0,10,0,4"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{loc:Translate Key=S024}"
                                   TextWrapping="Wrap" />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollView>
</Page>
