<Window
    x:Class="ThreeFingerDragOnWindows.settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:ThreeFingerDragOnWindows.localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Touchpad Control"
    Closed="Window_Closed">


    <RelativePanel>

        <StackPanel
            RelativePanel.AlignLeftWithPanel="True"
            RelativePanel.AlignRightWithPanel="True"
            x:Name="TitleBar"
            Height="48"
            Orientation="Horizontal"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

            <Border Height="48" Margin="12,0,0,0">
                <Image Source="/Assets/icon-52.png" Height="28" />
            </Border>


            <Border Height="48" Margin="12,0,0,0">
                <TextBlock
                    Text="Touchpad Control"
                    FontSize="14"
                    FontWeight="Medium"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Center" />
            </Border>
        </StackPanel>

        <NavigationView x:Name="NavigationView"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsBackEnabled="False"
                        SelectionChanged="NavigationView_SelectionChanged"
                        Header="Header"
                        AlwaysShowHeader="True"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="640"
                        ExpandedModeThresholdWidth="900"
                        SelectionFollowsFocus="Disabled"
                        OpenPaneLength="256"
                        IsPaneToggleButtonVisible="True"
                        PaneTitle="{loc:Translate Key=S128}"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        RelativePanel.Below="TitleBar"
                        RelativePanel.AlignBottomWithPanel="True"
                        RelativePanel.AlignLeftWithPanel="True"
                        RelativePanel.AlignRightWithPanel="True">

            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewHeaderMargin">32,28,0,20</Thickness>
            </NavigationView.Resources>


            <NavigationView.MenuItems>
                <NavigationViewItem Content="{loc:Translate Key=S001}" Tag="Touchpad" x:Name="Touchpad"
                                    MinHeight="44" Margin="0,2" ToolTipService.ToolTip="{loc:Translate Key=S001}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEFA5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{loc:Translate Key=S002}" Tag="ThreeFingerDrag" x:Name="ThreeFingerDrag"
                                    MinHeight="44" Margin="0,2" ToolTipService.ToolTip="{loc:Translate Key=S002}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE759;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{loc:Translate Key=S003}" Tag="Other Settings" x:Name="OtherSettings"
                                    MinHeight="44" ToolTipService.ToolTip="{loc:Translate Key=S074}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Button x:Name="AppMenuButton" Margin="8,4,8,12" MinHeight="44"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        SizeChanged="AppMenuButton_SizeChanged"
                        AutomationProperties.Name="{loc:Translate Key=S122}"
                        ToolTipService.ToolTip="{loc:Translate Key=S122}">
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem x:Name="CloseApp" Text="{loc:Translate Key=S123}" Click="CloseButton_Click"
                                            ToolTipService.ToolTip="{loc:Translate Key=S124}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="QuitApp" Text="{loc:Translate Key=S005}" Click="QuitButton_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <TextBlock x:Name="AppMenuLabel" Text="{loc:Translate Key=S122}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>


            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </RelativePanel>
</Window>
