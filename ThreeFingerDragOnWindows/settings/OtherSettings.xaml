<Page
    x:Class="ThreeFingerDragOnWindows.settings.OtherSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:ThreeFingerDragOnWindows.localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:WinUICommunity"
    mc:Ignorable="d">


    <ScrollView Margin="0"
                HorizontalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,0,32,32" MaxWidth="920" HorizontalAlignment="Stretch"
                    ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
                    Spacing="8">

            <wuc:SettingsCard Header="{loc:Translate Key=S074}"
                              Description="{loc:Translate Key=S112}"
                              HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE775;}">
                <ComboBox x:Name="LanguagePicker" MinWidth="220" AutomationProperties.Name="语言 / Language"
                          SelectionChanged="LanguagePicker_SelectionChanged">
                    <ComboBoxItem Tag="system" Content="跟随系统 / Follow system" />
                    <ComboBoxItem Tag="zh-Hans" Content="简体中文" />
                    <ComboBoxItem Tag="en" Content="English" />
                </ComboBox>
            </wuc:SettingsCard>
            <InfoBar x:Name="LanguageStatus" IsOpen="False" IsClosable="False" Severity="Error" />


            <TextBlock Text="{loc:Translate Key=S148}" Margin="0,20,0,4" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <wuc:SettingsCard Header="{loc:Translate Key=S060}"
                              Description="{loc:Translate Key=S082}"
                              HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily},
                                                                    Glyph=&#xF83E;}">
                <ToggleSwitch OnContent="{loc:Translate Key=S076}" OffContent="{loc:Translate Key=S077}" x:Name="RunAtStartup"
                              Toggled="RunAtStartup_Toggled" />
            </wuc:SettingsCard>

            <InfoBar Title=""
                     x:Name="StartupStatus"
                     IsClosable="False"
                     IsOpen="True"
                     Severity="Informational" />

            <InfoBar
                Title="{loc:Translate Key=S061}"
                x:Name="ElevatedStartupInformation"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />


            <wuc:SettingsCard Header="{loc:Translate Key=S062}"
                              Description="{loc:Translate Key=S063}"
                              HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily},
                                                                    Glyph=&#xE7EF;}">
                <ToggleSwitch OnContent="{loc:Translate Key=S076}" OffContent="{loc:Translate Key=S077}" x:Name="RunElevated" Toggled="RunElevated_Toggled"
                              />
            </wuc:SettingsCard>
            <InfoBar Title=""
                     x:Name="ElevatedStatus"
                     IsClosable="False"
                     IsOpen="True"
                     Severity="Informational" />

            <TextBlock Text="{loc:Translate Key=S149}" Margin="0,20,0,4" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <wuc:SettingsCard Header="{loc:Translate Key=S064}"
                              Description="{loc:Translate Key=S065}"
                              HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE8E5;}">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                    <ToggleSwitch OnContent="{loc:Translate Key=S076}" OffContent="{loc:Translate Key=S077}" x:Name="RecordLogs" Toggled="RecordLogs_Toggled" />
                    <Button x:Name="SaveLogsButton" Content="{loc:Translate Key=S066}" Click="SaveLogsButton_Click" />
                </StackPanel>

            </wuc:SettingsCard>
            <InfoBar x:Name="LogStatus" IsOpen="False" IsClosable="True" Severity="Error" />
            <wuc:SettingsGroup Header="{loc:Translate Key=S067}">
                <wuc:SettingsGroup.Items>
                    <wuc:SettingsExpander Description="{loc:Translate Key=S083}"
                                          Header="Touchpad Control">
                        <wuc:SettingsExpander.HeaderIcon>
                            <BitmapIcon ShowAsMonochrome="False"
                                        UriSource="ms-appx:///Assets/icon-52.png" />
                        </wuc:SettingsExpander.HeaderIcon>

                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   x:Name="VersionText" />

                        <wuc:SettingsExpander.Items>
                            <wuc:SettingsCard HorizontalContentAlignment="Left"
                                              ContentAlignment="Left">
                                <StackPanel Margin="-12,0,0,0"
                                            Orientation="Vertical">
                                    <HyperlinkButton Content="{loc:Translate Key=S068}"
                                                     NavigateUri="https://github.com/ClementGre/ThreeFingerDragOnWindows"
                                                     Margin="0,0,0,5" />
                                    <HyperlinkButton Content="{loc:Translate Key=S069}"
                                                     NavigateUri="https://www.paypal.com/paypalme/themsou" />
                                </StackPanel>
                            </wuc:SettingsCard>
                        </wuc:SettingsExpander.Items>
                    </wuc:SettingsExpander>
                    <HyperlinkButton Margin="0,8,0,0"
                                     Content="{loc:Translate Key=S070}"
                                     NavigateUri="https://github.com/ClementGre/ThreeFingerDragOnWindows/issues/new" />
                </wuc:SettingsGroup.Items>
            </wuc:SettingsGroup>


        </StackPanel>
    </ScrollView>

</Page>
