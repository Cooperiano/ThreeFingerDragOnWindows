<Page x:Class="ThreeFingerDragOnWindows.settings.ThreeFingerDragSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="using:ThreeFingerDragOnWindows.localization"
      xmlns:local="using:ThreeFingerDragOnWindows.touchpad"
      xmlns:settings="using:ThreeFingerDragOnWindows.settings"
      xmlns:wuc="using:WinUICommunity">
    <Pivot Margin="20,0,20,0">
        <PivotItem Header="{loc:Translate Key=S169}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Spacing="12" Margin="12,0,12,32">
                    <settings:UnifiedTrackingControl />
                    <TextBlock Text="{loc:Translate Key=S141}" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind NativeMotionStatusProperty, Mode=OneWay}" />
                    <wuc:SettingsCard Header="{loc:Translate Key=S028}" Description="{loc:Translate Key=S027}">
                        <ToggleSwitch x:Name="Enabled" IsOn="{x:Bind EnabledProperty, Mode=TwoWay}"
                                      OnContent="{loc:Translate Key=S076}" OffContent="{loc:Translate Key=S077}" />
                    </wuc:SettingsCard>
                    <wuc:SettingsCard Header="{loc:Translate Key=S042}" Description="{loc:Translate Key=S041}"
                                      IsEnabled="{Binding ElementName=Enabled, Path=IsOn}">
                        <ComboBox SelectedIndex="{x:Bind ButtonTypeProperty, Mode=TwoWay}" MinWidth="180">
                            <ComboBoxItem Content="{loc:Translate Key=S078}" /><ComboBoxItem Content="{loc:Translate Key=S079}" />
                            <ComboBoxItem Content="{loc:Translate Key=S080}" /><ComboBoxItem Content="{loc:Translate Key=S081}" />
                        </ComboBox>
                    </wuc:SettingsCard>
                    <ItemsControl ItemsSource="{x:Bind MouseSpeedSettingItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:MouseSpeedSettings">
                                <wuc:SettingsCard Header="{x:Bind Header}" Description="{loc:Translate Key=S189}">
                                    <ToggleSwitch IsOn="{x:Bind CursorMoveProperty, Mode=TwoWay}"
                                                  OnContent="{loc:Translate Key=S076}" OffContent="{loc:Translate Key=S077}" />
                                </wuc:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind SaveStatusMessageProperty, Mode=OneWay}"
                             Severity="{x:Bind SaveStatusSeverityProperty, Mode=OneWay}" />
                    <Expander Header="{loc:Translate Key=S150}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <wuc:SettingsCard Header="{loc:Translate Key=S051}" Description="{loc:Translate Key=S052}">
                                <NumberBox Minimum="0" Maximum="{x:Bind StartDragThresholdMaximum}"
                                           Value="{x:Bind StartDragThresholdProperty, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact" MinWidth="100" />
                            </wuc:SettingsCard>
                            <wuc:SettingsCard Header="{loc:Translate Key=S057}" Description="{loc:Translate Key=S056}">
                                <NumberBox Minimum="0" Maximum="{x:Bind MaxFingerMoveDistanceMaximum}"
                                           Value="{x:Bind MaxFingerMoveDistanceProperty, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact" MinWidth="100" />
                            </wuc:SettingsCard>
                            <InfoBar Title="{loc:Translate Key=S157}" Message="{loc:Translate Key=S158}" IsOpen="True" IsClosable="False" />
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="{loc:Translate Key=S190}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="{loc:Translate Key=S040}" Click="OpenSettings" MinHeight="44" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
        <PivotItem Header="{loc:Translate Key=S170}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="920" Spacing="16" Margin="12,0,12,32">
                    <TextBlock Text="{loc:Translate Key=S172}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="{loc:Translate Key=S040}" Click="OpenSettings" MinHeight="44" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
        <PivotItem Header="{loc:Translate Key=S171}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="920" Spacing="12" Margin="12,0,12,32">
                    <TextBlock Text="{loc:Translate Key=S173}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="{loc:Translate Key=S040}" Click="OpenSettings" MinHeight="44" />
                    <wuc:SettingsCard Header="{loc:Translate Key=S031}" Description="{loc:Translate Key=S032}">
                        <ToggleSwitch x:Name="FourFingerEnabled" IsOn="{x:Bind FourFingerEnabledProperty, Mode=TwoWay}"
                                      OnContent="{loc:Translate Key=S076}" OffContent="{loc:Translate Key=S077}" />
                    </wuc:SettingsCard>
                    <wuc:SettingsCard Header="{loc:Translate Key=S033}" Description="{loc:Translate Key=S034}"
                                      IsEnabled="{Binding ElementName=FourFingerEnabled, Path=IsOn}">
                        <Button Content="{loc:Translate Key=S035}" Click="OpenOverview" MinHeight="44" />
                    </wuc:SettingsCard>
                    <Expander Header="{loc:Translate Key=S150}" HorizontalAlignment="Stretch">
                        <wuc:SettingsCard Header="{loc:Translate Key=S036}" Description="{loc:Translate Key=S037}"
                                          IsEnabled="{Binding ElementName=FourFingerEnabled, Path=IsOn}">
                            <NumberBox Minimum="40" Maximum="1000" SmallChange="10"
                                       Value="{x:Bind FourFingerSwipeThresholdProperty, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Compact" MinWidth="100" />
                        </wuc:SettingsCard>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
